# Copy this file to `.env` (or set the same variables in your shell).
# Every variable is optional; the app uses sensible defaults when unset.

# ─── Security ──────────────────────────────────────────────
# Session signing key. CHANGE THIS in any real deployment.
SECRET_KEY=change-me-to-a-long-random-string

# ─── Server ────────────────────────────────────────────────
PORT=5001
HOST=127.0.0.1
FLASK_DEBUG=false

# ─── Database ──────────────────────────────────────────────
# Default: SQLite file `app.db` in the project folder (created automatically
# on first run). Point this at a PostgreSQL database if desired.
# DATABASE_URL=sqlite:///app.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Socket.IO / CORS ──────────────────────────────────────
# Comma-separated list of allowed origins. Defaults are derived from PORT/HOST.
# SOCKETIO_ALLOWED_ORIGINS=http://127.0.0.1:5001,http://localhost:5001
# Legacy fallback name:
# CORS_ORIGINS=http://127.0.0.1:5001

# ─── Development ───────────────────────────────────────────
# Reserved for future use; not currently read by the code.
# UNINET_DEV=1
